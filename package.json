{
  "name": "ismo-project-management",
  "version": "1.0.0",
  "description": "Full Stack Project Management System — Web + Mobile",
  "private": true,
  "scripts": {
    "dev:backend": "npm --prefix backend run dev",
    "dev:web": "npm --prefix web run dev",
    "dev:mobile": "npm --prefix mobile run start",
    "build:backend": "npm --prefix backend run build",
    "build:web": "npm --prefix web run build",
    "test": "npm --prefix backend run test",
    "db:push": "npm --prefix backend run db:push",
    "db:migrate": "npm --prefix backend run db:migrate",
    "db:seed": "npm --prefix backend run db:seed",
    "db:studio": "npm --prefix backend run db:studio",
    "sync": "node shared/sync.mjs",
    "lint": "npm --prefix backend run lint && npm --prefix web run lint"
  }
}

