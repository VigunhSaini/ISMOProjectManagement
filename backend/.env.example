# Backend environment variables
# Copy this file to .env and fill in your Supabase values

# ─── Supabase PostgreSQL ────────────────────────────────────────────────────
# Transaction Pooler  (port 6543 — used at runtime)
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"

# Session Pooler or Direct (port 5432 — used for migrations only)
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:5432/postgres"

# ─── JWT ────────────────────────────────────────────────────────────────────
JWT_SECRET="change-me-to-a-long-random-secret-at-least-64-chars"
JWT_EXPIRES_IN="7d"

# ─── Server ─────────────────────────────────────────────────────────────────
NODE_ENV="development"
PORT=5000

# ─── CORS ───────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins
CORS_ORIGINS="http://localhost:5173,http://localhost:3000"

